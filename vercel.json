{
  "redirects": [
    { "source": "/initiative-tracker", "destination": "/initiative", "permanent": true },
    { "source": "/:path(.*)", "destination": "https://thesiteofmanythings.com/:path", "permanent": true, "has": [{ "type": "host", "value": "www.thesiteofmanythings.com" }] },
    { "source": "/:path(.*)", "destination": "https://thesiteofmanythings.com/:path", "permanent": true, "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }] }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}