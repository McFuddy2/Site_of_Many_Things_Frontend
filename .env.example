# Default frontend API target for local frontend development.
# Use local backend only when you intentionally override this value.
VITE_API_BASE_URL=https://api.thesiteofmanythings.com
# Set to true to run the accounts feature against the in-memory mock API
# (src/API/mockAuth.js and src/storage/mockAdapter.js) with no backend at all.
# Verification and password-reset links are printed to the browser console.
# Leave unset or false to talk to the real API.
VITE_USE_MOCK_API=false
